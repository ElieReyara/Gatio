# Copier en .env pour changer les valeurs locales. En production, toutes ces
# variables sont obligatoires (aucune valeur par défaut).
NODE_ENV=development

# API (en conteneur de production : API_HOST=0.0.0.0)
API_HOST=127.0.0.1
API_PORT=4000
DATABASE_URL=postgres://gatio:gatio@localhost:5432/gatio
LOG_LEVEL=info
# Signature des QR codes (Ed25519). Générer : pnpm --filter @gatio/api keys:generate
# Facultative en développement (clé éphémère : QR invalides après redémarrage), obligatoire en production.
TICKET_SIGNING_KEY_ID=1
TICKET_SIGNING_PRIVATE_KEY=

# Codes SMS des acheteurs (R31) : secret de hachage, 32 caractères au moins, obligatoire en
# production (générer une valeur aléatoire, ne jamais la mettre ici).
OTP_SECRET=
# Code SMS avant la première réservation depuis un téléphone (journal de bord n° 71) ;
# off = retour à la double saisie du numéro (si les SMS n'arrivent plus).
BUYER_PHONE_VERIFICATION=on
# Passerelle SMS Android pour un essai réel (PC-8) ; vide = SMS affichés dans la console de
# l'API. Ex. : http://<adresse du téléphone>:8080/message ; identifiants dans .env seulement.
SMS_GATEWAY_URL=
SMS_GATEWAY_LOGIN=
SMS_GATEWAY_PASSWORD=

# Web (lu côté serveur par Next.js)
API_URL=http://127.0.0.1:4000

# Aucune statistique envoyée à Next.js (pas d’envoi vers l’extérieur non demandé)
NEXT_TELEMETRY_DISABLED=1

# Dossier des images en développement (stockage S3 en production)
STORAGE_DIR=.data/media

# Site public (lu par Next.js).
# SITE_URL : adresse des liens de vente et des aperçus de partage ; vide = adresse par
# laquelle le site est consulté (localhost, tunnel). En production, la renseigner.
SITE_URL=
# Contacts de la page de support (vides = non affichés). Les vraies valeurs vont dans .env,
# jamais ici : ce fichier est publié avec le code.
SUPPORT_WHATSAPP=
SUPPORT_EMAIL=
